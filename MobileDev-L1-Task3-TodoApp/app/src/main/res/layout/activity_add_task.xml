<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAddTask"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".modules.home.AddTaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="37dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/kanit_bold"
            android:text="New task"
            android:textColor="@color/tf_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/kanit_regular"
            android:text="What do you want to get done?"
            android:textColor="@color/tf_text_secondary"
            android:textSize="18sp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/kanit_bold"
            android:text="Title"
            android:textColor="@color/tf_lable"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/kanit_regular"
            android:hint="e.g. Study accounting"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/tf_text_primary"
            android:textColorHint="@color/text_color_hint"
            android:textSize="17sp" />

        <!-- Note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/kanit_bold"
            android:text="Note (optional)"
            android:textColor="@color/tf_lable"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/kanit_regular"
            android:gravity="top|start"
            android:hint="Add some details"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="110dp"
            android:padding="18dp"
            android:textColor="@color/tf_text_primary"
            android:textColorHint="@color/text_color_hint"
            android:textSize="17sp" />

        <!-- Priority -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/kanit_bold"
            android:text="Priority"
            android:textColor="@color/tf_lable"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLow"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="@font/kanit_regular"
                android:text="Low"
                android:textColor="@color/tf_primary"
                android:textSize="15sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="12dp"
                app:chipStrokeColor="@color/tf_primary"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMedium"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="@font/kanit_regular"
                android:text="Medium"
                android:textColor="@color/tf_primary"
                android:textSize="15sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="12dp"
                app:chipStrokeColor="@color/tf_primary"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHigh"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="@font/kanit_regular"
                android:text="High"
                android:textColor="@color/tf_primary"
                android:textSize="15sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="12dp"
                app:chipStrokeColor="@color/tf_primary"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Due date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/kanit_bold"
            android:text="Due date"
            android:textColor="@color/tf_lable"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llDueDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/tvDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/kanit_regular"
                android:text="Pick a date"
                android:textColor="@color/text_color_hint"
                android:textSize="17sp" />

<!--            <ImageView-->
<!--                android:layout_width="22dp"-->
<!--                android:layout_height="22dp"-->
<!--                android:contentDescription="Pick a date"-->
<!--                android:src="@drawable/ic_calendar" />-->
        </LinearLayout>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="@color/tf_primary"
            android:fontFamily="@font/kanit_bold"
            android:text="Add Task"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFDFD0"
            android:fontFamily="@font/kanit_bold"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/tf_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>