<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_lable"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TodoApplication"
        tools:targetApi="31">
        <activity
            android:name=".modules.auth.view.ForgetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".modules.home.view.AddTaskActivity"
            android:exported="false" />
        <activity
            android:name=".modules.home.view.MainActivity"
            android:exported="false" />
        <activity
            android:name=".modules.auth.view.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".modules.auth.view.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".modules.onboarding.view.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".modules.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TodoApplication.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>